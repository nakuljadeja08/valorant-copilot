# Development key — regenerate daily at developer.riotgames.com
# Only val-content-v1 / val-status-v1 work with this key.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# sim | live   (live requires an approved production key)
RIOT_DATA_SOURCE=sim

# Platform + regional routing
RIOT_PLATFORM=na
RIOT_REGION=americas

# Local store
DB_PATH=data/copilot.db

# Deterministic simulator seed
SIM_SEED=1337
